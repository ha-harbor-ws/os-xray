<?xml version="1.0"?>
<model>
    <mount>//OPNsense/xray/general</mount>
    <description>Xray General Settings</description>
    <version>1.0.8</version>
    <items>
        <enabled type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </enabled>
        <!-- E1: watchdog — автоперезапуск через cron при падении xray-core или tun2socks -->
        <watchdog_enabled type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </watchdog_enabled>
        <bgp_enabled type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </bgp_enabled>
        <bgp_if_wan4 type="TextField">
            <Default>igc3</Default>
            <Required>Y</Required>
            <Mask>/^[A-Za-z][A-Za-z0-9._-]*$/</Mask>
            <ValidationMessage>WAN4 must be a FreeBSD interface name (e.g. igc3).</ValidationMessage>
        </bgp_if_wan4>
        <bgp_if_wan6 type="TextField">
            <Default>igc3</Default>
            <Required>Y</Required>
            <Mask>/^[A-Za-z][A-Za-z0-9._-]*$/</Mask>
            <ValidationMessage>WAN6 must be a FreeBSD interface name (e.g. igc3).</ValidationMessage>
        </bgp_if_wan6>
        <dnstap_bgp_enabled type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </dnstap_bgp_enabled>
        <bgp_auto_route type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </bgp_auto_route>
        <bgp_weight_used_ipv4 type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </bgp_weight_used_ipv4>
        <bgp_weight_used_ipv6 type="BooleanField">
            <default>0</default>
            <Required>N</Required>
        </bgp_weight_used_ipv6>
        <bgp_auto_route_polls type="IntegerField">
            <Default>3</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>20</MaximumValue>
            <Required>Y</Required>
            <ValidationMessage>Polls must be an integer from 1 to 20.</ValidationMessage>
        </bgp_auto_route_polls>
        <bgp_auto_route_interval type="IntegerField">
            <Default>10</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>1440</MaximumValue>
            <Required>Y</Required>
            <ValidationMessage>Interval must be from 1 to 1440 minutes.</ValidationMessage>
        </bgp_auto_route_interval>
    </items>
</model>
