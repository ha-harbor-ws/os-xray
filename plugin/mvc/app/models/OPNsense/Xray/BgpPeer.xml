<?xml version="1.0"?>
<model>
    <mount>//OPNsense/xray/bgppeers</mount>
    <description>Xray BGP peer settings</description>
    <version>1.0.1</version>
    <items>
        <peer type="ArrayField">
            <enabled type="BooleanField">
                <Default>1</Default>
            </enabled>
            <name type="TextField">
                <Required>Y</Required>
                <Mask>/^[A-Za-z_][A-Za-z0-9_]*$/</Mask>
                <ValidationMessage>BIRD protocol name: letters, digits, underscore; must start with a letter or underscore</ValidationMessage>
            </name>
            <local_as type="IntegerField">
                <Default>65103</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>4294967295</MaximumValue>
                <Required>Y</Required>
            </local_as>
            <neighbor type="TextField">
                <Required>Y</Required>
                <Mask>/^([0-9]{1,3}(\.[0-9]{1,3}){3}|[0-9a-fA-F:]+)$/</Mask>
                <ValidationMessage>Must be a valid IPv4 or IPv6 address</ValidationMessage>
            </neighbor>
            <neighbor_as type="IntegerField">
                <Default>65412</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>4294967295</MaximumValue>
                <Required>Y</Required>
            </neighbor_as>
            <source_address type="TextField">
                <Required>N</Required>
            </source_address>
            <ipv4 type="BooleanField">
                <Default>1</Default>
            </ipv4>
            <ipv4_import type="TextField">
                <Default>accept_refilter</Default>
                <Required>N</Required>
            </ipv4_import>
            <ipv4_community_name type="TextField">
                <Required>N</Required>
            </ipv4_community_name>
            <ipv4_community type="TextField">
                <Required>N</Required>
            </ipv4_community>
            <ipv4_export type="TextField">
                <Default>none</Default>
                <Required>N</Required>
            </ipv4_export>
            <ipv6 type="BooleanField">
                <Default>0</Default>
            </ipv6>
            <ipv6_import type="TextField">
                <Default>accept_antifilter_network_v6</Default>
                <Required>N</Required>
            </ipv6_import>
            <ipv6_community_name type="TextField">
                <Required>N</Required>
            </ipv6_community_name>
            <ipv6_community type="TextField">
                <Required>N</Required>
            </ipv6_community>
            <ipv6_export type="TextField">
                <Default>none</Default>
                <Required>N</Required>
            </ipv6_export>
            <multihop type="BooleanField">
                <Default>1</Default>
            </multihop>
            <hold_time type="IntegerField">
                <Default>240</Default>
                <MinimumValue>3</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
            </hold_time>
        </peer>
    </items>
</model>
